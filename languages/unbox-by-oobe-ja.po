#. Plugin Name of the plugin
#: unbox.php
msgid "Unbox by oobe"
msgstr "Unbox by oobe"

#. Description of the plugin
#: unbox.php
msgid "Move a whole WordPress site to another server or into LocalWP. No size limit. Exports .unbox (compatible with .wpress) and LocalWP-ready zip files."
msgstr "WordPress サイトを丸ごと別のサーバーや LocalWP へ移行します。容量の上限はありません。.unbox (.wpress 互換) と、LocalWP にそのままインポートできる zip をエクスポートできます。"

#. Author of the plugin
#: unbox.php
msgid "oobe"
msgstr "oobe"

#. Author URI of the plugin
#: unbox.php
msgid "https://oobe-io.com/"
msgstr "https://oobe-io.com/"

